---
import Layout from '../../layouts/Layout.astro';
import { notes } from '../../data/notes';

export function getStaticPaths() {
  return notes.map((note) => ({ params: { slug: note.slug }, props: { note } }));
}

const { note } = Astro.props;
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title={`${note.title} | Hossam Emad`} description={note.summary} type="article">
  <main class="mx-auto max-w-2xl px-6 py-16 lg:px-8">
    <a href="/notes" class="text-sm font-semibold text-sky-300 hover:text-sky-200">← All notes</a>
    <article class="mt-6">
      <p class="text-xs uppercase tracking-[0.18em] text-slate-500">{fmt(note.date)} · {note.tags.join(' · ')}</p>
      <h1 class="mt-3 text-3xl font-bold text-white sm:text-4xl">{note.title}</h1>
      <div class="mt-8 space-y-5 text-[1.05rem]">
        {note.body.map((b) =>
          'p' in b ? <p class="text-slate-300">{b.p}</p>
          : 'h' in b ? <h2 class="pt-4 text-xl font-semibold text-white">{b.h}</h2>
          : 'ul' in b ? <ul class="list-disc space-y-2 pl-6 text-slate-300 marker:text-sky-400">{b.ul.map((i) => <li>{i}</li>)}</ul>
          : <ol class="list-decimal space-y-2 pl-6 text-slate-300 marker:text-sky-400">{b.ol.map((i) => <li>{i}</li>)}</ol>
        )}
      </div>
    </article>
    <div class="mt-14 rounded-2xl border border-white/10 bg-ink-800/70 p-6">
      <p class="font-semibold text-white">Working on hardware like this?</p>
      <p class="mt-1">I take on PCB design, design review and firmware projects.</p>
      <a href="/#contact" class="mt-4 inline-block rounded-full bg-sky-400 px-5 py-2.5 text-sm font-semibold text-ink-900 hover:bg-sky-300">Get in touch</a>
    </div>
  </main>
</Layout>

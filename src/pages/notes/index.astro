---
import Layout from '../../layouts/Layout.astro';
import { notes } from '../../data/notes';

const sorted = [...notes].sort((a, b) => b.date.localeCompare(a.date));
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Layout title="Notes | Hossam Emad" description="Short engineering notes on PCB design, bring-up, firmware and hardware product development.">
  <main class="mx-auto max-w-3xl px-6 py-16 lg:px-8">
    <p class="eyebrow">Notes</p>
    <h1 class="mt-3 text-4xl font-bold text-white">Lessons from the bench</h1>
    <p class="mt-4 text-lg">Short notes from real projects: PCB design, bring-up, firmware and taking hardware to production.</p>
    <ul class="mt-10 divide-y divide-white/10 border-y border-white/10">
      {sorted.map((n) => (
        <li class="reveal">
          <a href={`/notes/${n.slug}`} class="group block py-6">
            <p class="text-xs uppercase tracking-[0.18em] text-slate-500">{fmt(n.date)} · {n.tags.join(' · ')}</p>
            <h2 class="mt-2 text-xl font-semibold text-white group-hover:text-sky-300">{n.title}</h2>
            <p class="mt-1">{n.summary}</p>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>

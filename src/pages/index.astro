---
import Layout from '../layouts/Layout.astro';
import { featuredProjects } from '../data/projects';
import { notes } from '../data/notes';
import { contact, metrics, certifications, testimonials, lab } from '../data/site';

const skillGroups = [
  {
    label: 'Hardware & PCB',
    skills: ['Multi-layer PCB design (up to 4 layers)', 'Stackup planning & controlled impedance (USB, CAN, RF)', 'EMI mitigation', 'RF subsystem design', 'Battery Management Systems (3-cell)', 'Board bring-up & field debugging', 'Gerber / BOM / CPL preparation', 'Fab coordination (JLCPCB)'],
  },
  {
    label: 'Firmware & Software',
    skills: ['Embedded C (production-grade)', 'FreeRTOS', 'Python (prototyping & validation)', 'SMS / MQTT / HTTP', 'GPS data processing', 'FOTA', 'Geofencing algorithms', 'Root-cause analysis'],
  },
  {
    label: 'Microcontrollers & Platforms',
    skills: ['STM32 (F4)', 'ESP32 / ESP32-S3', 'ESP8266', 'SIMCom 4G modules', 'AVR'],
  },
  {
    label: 'Protocols & Interfaces',
    skills: ['CAN (High-Speed, SWCAN)', 'USB', 'UART / SPI / I²C', 'RS232 / RS485', 'Ethernet', 'Wi-Fi / BLE', '4G (SIMCom)', 'ADC / GPIO'],
  },
  {
    label: 'Tools',
    skills: ['Altium Designer', 'KiCad', 'EAGLE', 'EasyEDA Pro', 'Autodesk Fusion 360', 'LTspice', 'MATLAB / Simulink'],
  },
];

const experience = [
  {
    period: 'Feb 2026 — Present',
    title: 'Hardware Engineer',
    org: 'SEITech Solutions (Acquired by T&S Group), Smart Village, Cairo',
    body: 'Own hardware from concept through manufacturing and field support for automotive telematics and industrial IoT products, including Ethernet/RS485 industrial controllers and an STM32F407 + ESP32-S3 controller platform.',
  },
  {
    period: 'Jul 2024 — Feb 2026',
    title: 'Embedded Systems Engineer',
    org: 'SEITech Solutions (Acquired by T&S Group), Smart Village, Cairo',
    body: 'Redesigned the SEIFence IoT tracker (V1 field issues across ~200 units → 4-layer V2, 120+ units in production), led ForWheelz automotive telematics ECU hardware, and redesigned the SEITech Box industrial gateway with its 3-cell BMS backup module.',
  },
  {
    period: 'Jan 2024 — Feb 2024',
    title: 'Embedded Systems Engineer (Short-term contract)',
    org: 'Noziqs Medical, Nasr City',
    body: 'Developed embedded firmware for operating tables, improving system functionality by 30% and reducing device downtime by 20% through board-level troubleshooting and root-cause analysis.',
  },
];

const education = [
  { period: 'Feb 2024 — Jul 2024', title: 'Automotive Embedded Systems Diploma', org: 'NTI, New Capital', body: 'Embedded C, RTOS, STM32 & AVR, CAN/LIN/UART/SPI/I²C, bootloader/FOTA. Graduation project: a custom STM32F407 + ESP32-S3 industrial IoT controller platform.' },
  { period: 'Sep 2017 — Jul 2022', title: 'B.Sc. Electronics and Control Engineering', org: 'Menoufia University — Grade: Very Good', body: '' },
];

const latestNotes = [...notes].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);
const btn = 'inline-flex items-center gap-2 rounded-full px-6 py-3 text-base font-semibold transition hover:-translate-y-0.5';
---

<Layout>
  <main>
    <!-- Hero -->
    <section class="trace-bg">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-6 pb-14 pt-20 lg:grid-cols-[1.15fr_0.85fr] lg:px-8 lg:pt-28">
        <div class="reveal">
          <p class="eyebrow">Hardware Engineer · Embedded Systems</p>
          <h1 class="mt-5 text-4xl font-bold text-white sm:text-5xl lg:text-[3.5rem]">Designing dependable electronics from idea to production.</h1>
          <p class="mt-6 max-w-2xl text-lg text-slate-300">
            2+ years turning field problems into shipped hardware — 4-layer PCB design, RTOS firmware, EMI mitigation and BMS for automotive and industrial IoT, with ownership from concept through manufacturing and deployment.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#projects" class={`${btn} bg-sky-400 text-ink-900 hover:bg-sky-300`}>View projects</a>
            <a href="#contact" class={`${btn} border border-white/15 text-slate-200 hover:bg-white/10`}>Work with me</a>
          </div>
          <p class="mt-6 text-sm text-slate-400">Giza, Egypt · Open to roles &amp; freelance projects</p>
        </div>
        <div class="reveal overflow-hidden rounded-3xl border border-white/10 bg-ink-800/70">
          <img src="/images/hero/circuit-hero.svg" alt="" class="h-56 w-full object-cover" />
          <div class="grid grid-cols-2 gap-px bg-white/5 text-sm text-slate-200">
            <div class="bg-ink-800 p-4">4-layer PCB &amp; signal integrity</div>
            <div class="bg-ink-800 p-4">RTOS firmware (FreeRTOS)</div>
            <div class="bg-ink-800 p-4">BMS &amp; power electronics</div>
            <div class="bg-ink-800 p-4">Automotive &amp; industrial IoT</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Numbers -->
    <section aria-label="Highlights" class="border-y border-white/10 bg-ink-900/50">
      <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-8 px-6 py-10 sm:grid-cols-3 lg:grid-cols-5 lg:px-8">
        {metrics.map((m) => (
          <div class="reveal">
            <dt class="sr-only">{m.label}</dt>
            <dd class="font-display text-3xl font-bold text-sky-300">{m.value}</dd>
            <dd class="mt-1 text-sm leading-snug text-slate-400">{m.label}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- About -->
    <section id="about">
      <div class="mx-auto grid max-w-6xl gap-6 px-6 py-20 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
        <div class="reveal">
          <p class="eyebrow">About</p>
          <h2 class="section-heading">From field problem to shipped board</h2>
        </div>
        <div class="reveal space-y-4">
          <p class="section-copy">
            I'm a Hardware Engineer with 2+ years of hands-on work in hardware design, PCB layout, firmware and production support. I find issues in fielded devices, propose the fix, and deliver the improved hardware and firmware revision end-to-end.
          </p>
          <p class="section-copy">
            My work spans automotive telematics and industrial IoT: 4-layer impedance-controlled PCBs, EMI mitigation, RF layout, battery management and FreeRTOS firmware — from the first schematic to manufacturing files, bring-up and field support.
          </p>
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="border-t border-white/10">
      <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8">
        <p class="eyebrow reveal">Skills</p>
        <h2 class="section-heading reveal">Core capabilities</h2>
        <div class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-2">
          {skillGroups.map((group) => (
            <div class="reveal border-t border-white/10 pt-5">
              <h3 class="text-base font-semibold text-sky-300">{group.label}</h3>
              <div class="mt-3 flex flex-wrap gap-2">
                {group.skills.map((skill) => (
                  <span class="rounded-full bg-white/5 px-3 py-1.5 text-sm text-slate-200">{skill}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="border-t border-white/10">
      <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8">
        <p class="eyebrow reveal">Projects</p>
        <h2 class="section-heading reveal">Engineering case studies</h2>
        <p class="section-copy reveal mt-3">Company projects are shown as simplified block diagrams and specifications.</p>
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {featuredProjects.map((project) => (
            <article class="reveal group flex flex-col rounded-2xl border border-white/10 bg-ink-800/70 p-6 transition hover:-translate-y-1 hover:border-sky-400/40">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">{project.category}</p>
              <p class="mt-4 inline-flex w-fit items-center gap-2 rounded-lg border border-sky-400/30 bg-sky-400/10 px-3 py-1.5 font-display text-lg font-bold text-sky-300">
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="6" width="12" height="12" rx="2" /><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4" /></svg>
                {project.chip}
              </p>
              <h3 class="mt-4 text-xl font-semibold text-white">{project.title}</h3>
              <ul class="mt-4 space-y-1.5 text-sm text-slate-300">
                {project.specs.slice(0, 3).map((s) => (
                  <li><span class="text-slate-500">{s.label}:</span> {s.value}</li>
                ))}
              </ul>
              <div class="mt-5 flex flex-wrap gap-1.5">
                {project.tags.map((tag) => (
                  <span class="rounded-full bg-white/5 px-2.5 py-1 text-xs text-slate-300">{tag}</span>
                ))}
              </div>
              <a href={project.href} class="mt-auto pt-6 text-sm font-semibold text-sky-300 transition group-hover:text-sky-200">Read case study →<span class="sr-only"> {project.title}</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Lab -->
    <section id="lab" class="border-t border-white/10">
      <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8">
        <p class="eyebrow reveal">Lab</p>
        <h2 class="section-heading reveal">Personal projects</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {lab.map((item) => (
            <article class="reveal rounded-2xl border border-dashed border-white/15 p-6">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-300">{item.status}</p>
              <h3 class="mt-2 text-xl font-semibold text-white">{item.title}</h3>
              <p class="mt-3 text-[0.98rem]">{item.body}</p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {item.tags.map((t) => <span class="rounded-full bg-white/5 px-2.5 py-1 text-xs text-slate-300">{t}</span>)}
              </div>
              {item.href && <a href={item.href} class="mt-5 inline-block text-sm font-semibold text-sky-300 hover:text-sky-200">Read case study →</a>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Experience & education -->
    <section id="experience" class="border-t border-white/10">
      <div class="mx-auto grid max-w-6xl gap-14 px-6 py-20 lg:grid-cols-2 lg:px-8">
        <div>
          <p class="eyebrow reveal">Experience</p>
          <h2 class="section-heading reveal">Career</h2>
          <ol class="mt-8 space-y-8 border-l border-ink-500/60 pl-6">
            {experience.map((item) => (
              <li class="reveal relative">
                <span class="absolute -left-[1.95rem] top-1.5 h-3 w-3 rounded-full border-2 border-sky-400 bg-ink-900"></span>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sky-300">{item.period}</p>
                <p class="mt-1 text-lg font-semibold text-white">{item.title}</p>
                <p class="text-sm text-slate-400">{item.org}</p>
                <p class="mt-2 text-[0.98rem]">{item.body}</p>
              </li>
            ))}
          </ol>
        </div>
        <div>
          <p class="eyebrow reveal">Education</p>
          <h2 class="section-heading reveal">Education</h2>
          <ol class="mt-8 space-y-8 border-l border-ink-500/60 pl-6">
            {education.map((item) => (
              <li class="reveal relative">
                <span class="absolute -left-[1.95rem] top-1.5 h-3 w-3 rounded-full border-2 border-sky-400 bg-ink-900"></span>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sky-300">{item.period}</p>
                <p class="mt-1 text-lg font-semibold text-white">{item.title}</p>
                <p class="text-sm text-slate-400">{item.org}</p>
                {item.body && <p class="mt-2 text-[0.98rem]">{item.body}</p>}
              </li>
            ))}
          </ol>
          <h3 class="reveal mt-12 text-lg font-semibold text-white">Certifications</h3>
          <ul class="mt-4 divide-y divide-white/10">
            {certifications.map((c) => (
              <li class="reveal flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3">
                <div>
                  <p class="text-[0.95rem] font-medium text-slate-100">{c.title}</p>
                  <p class="text-sm text-slate-400">{c.org} · {c.date}</p>
                </div>
                <a href={c.url} target="_blank" rel="noopener" class="text-sm font-semibold text-sky-300 hover:text-sky-200">Show credential ↗<span class="sr-only"> for {c.title}</span></a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {testimonials.length > 0 && (
      <section id="recommendations" class="border-t border-white/10">
        <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8">
          <p class="eyebrow reveal">Recommendations</p>
          <h2 class="section-heading reveal">What colleagues say</h2>
          <div class="mt-10 grid gap-6 md:grid-cols-2">
            {testimonials.map((t) => (
              <figure class="reveal border-l-2 border-sky-400/60 pl-5">
                <blockquote class="text-lg leading-relaxed text-slate-200">“{t.quote}”</blockquote>
                <figcaption class="mt-3 text-sm text-slate-400"><span class="font-semibold text-slate-200">{t.name}</span> · {t.role}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Notes -->
    <section id="notes" class="border-t border-white/10">
      <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="eyebrow reveal">Notes</p>
            <h2 class="section-heading reveal">Lessons from the bench</h2>
          </div>
          <a href="/notes" class="reveal text-sm font-semibold text-sky-300 hover:text-sky-200">All notes →</a>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {latestNotes.map((n) => (
            <a href={`/notes/${n.slug}`} class="reveal group block border-t border-white/10 pt-5">
              <p class="text-xs uppercase tracking-[0.18em] text-slate-500">{n.tags.join(' · ')}</p>
              <h3 class="mt-2 text-lg font-semibold text-white group-hover:text-sky-300">{n.title}</h3>
              <p class="mt-2 text-[0.95rem]">{n.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="border-t border-white/10">
      <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8">
        <div class="reveal rounded-3xl border border-sky-400/25 bg-gradient-to-br from-sky-400/10 to-ink-800/80 p-8 lg:p-12">
          <p class="eyebrow">Contact</p>
          <h2 class="section-heading">Have a board to design or review?</h2>
          <p class="section-copy mt-4">I'm open to hardware and embedded roles (remote or relocation) and to freelance PCB design, design review, and firmware projects. Send a short description of what you're building.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={`mailto:${contact.email}?subject=Hardware%20project`} class={`${btn} bg-sky-400 text-ink-900 hover:bg-sky-300`}>Email me</a>
            <a href={contact.whatsapp} target="_blank" rel="noopener" class={`${btn} bg-[#25D366] text-slate-950 hover:bg-[#20bd5a]`}>
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm4.52 11.99c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29z"/></svg>
              WhatsApp
            </a>
            <a href={contact.linkedin} class={`${btn} border border-white/15 text-slate-200 hover:bg-white/10`}>Message on LinkedIn</a>
            <a href="/resume" class={`${btn} border border-white/15 text-slate-200 hover:bg-white/10`}>Resume</a>
          </div>
          <p class="mt-6 text-sm text-slate-400">{contact.email} · WhatsApp +20 10 15891738 · Giza, Egypt</p>
        </div>
      </div>
    </section>
  </main>
</Layout>

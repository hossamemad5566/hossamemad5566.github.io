---
import Layout from '../layouts/Layout.astro';
import { featuredProjects } from '../data/projects';

const skillGroups = [
  {
    label: 'Firmware & Software',
    skills: ['Embedded C (production-grade)', 'FreeRTOS', 'Python (prototyping & validation)', 'SMS / MQTT / HTTP', 'GPS data processing', 'FOTA', 'Geofencing algorithms', 'Root-cause analysis'],
  },
  {
    label: 'Hardware & PCB',
    skills: ['Multi-layer PCB design (up to 4 layers)', 'Stackup planning & controlled impedance (USB, CAN, RF)', 'EMI mitigation', 'RF subsystem design', 'Battery Management Systems (3-cell)', 'Board bring-up & field debugging', 'Gerber / BOM / CPL preparation', 'Fab coordination (JLCPCB)'],
  },
  {
    label: 'Microcontrollers & Platforms',
    skills: ['STM32 (F4)', 'ESP32 / ESP32-S3', 'ESP8266', 'SIMCom 4G modules', 'AVR'],
  },
  {
    label: 'Protocols & Interfaces',
    skills: ['CAN (High-Speed, SWCAN)', 'USB', 'UART / SPI / I²C', 'RS232 / RS485', 'Wi-Fi / BLE', '4G (SIMCom)', 'ADC / GPIO'],
  },
  {
    label: 'Tools',
    skills: ['Altium Designer', 'KiCad', 'EAGLE', 'EasyEDA Pro', 'Autodesk Fusion 360', 'LTspice', 'MATLAB / Simulink'],
  },
];

const experience = [
  {
    period: 'Feb 2026 — Present',
    title: 'Hardware Engineer',
    org: 'SEITech Solutions (Acquired by T&S Group), Smart Village, Cairo',
    body: 'Own hardware from concept through manufacturing and field support for automotive telematics and industrial IoT products, including Ethernet/RS485 industrial controllers and an STM32F407 + ESP32-S3 controller platform.',
  },
  {
    period: 'Jul 2024 — Feb 2026',
    title: 'Embedded Systems Engineer',
    org: 'SEITech Solutions (Acquired by T&S Group), Smart Village, Cairo',
    body: 'Redesigned the SEIFence IoT tracker (V1 field issues across ~200 units → 4-layer V2, 120+ units in production), led ForWheelz automotive telematics ECU hardware, and redesigned the SEITech Box industrial gateway with its 3-cell BMS backup module.',
  },
  {
    period: 'Jan 2024 — Feb 2024',
    title: 'Embedded Systems Engineer (Short-term contract)',
    org: 'Noziqs Medical, Nasr City',
    body: 'Developed embedded firmware for operating tables, improving system functionality by 30% and reducing device downtime by 20% through board-level troubleshooting and root-cause analysis.',
  },
];

const education = [
  { period: 'Oct 2026', title: 'High-Speed Board Design — System on Module', org: 'EsteemPCB · Udemy', body: 'Layer stack-up and impedance control, SI/PI, LPDDR4/DDR interfaces, BGA fan-out and placement.' },
  { period: 'Aug — Sep 2026', title: 'MATLAB, Simulink & Stateflow Onramp', org: 'MathWorks', body: '' },
  { period: 'Jan 2026', title: 'Crash Course Electronics & PCB Design', org: 'Udemy · 112 hours', body: 'Analog/digital electronics and the full PCB flow: schematic → layout → fabrication → bring-up.' },
  { period: 'Feb 2024 — Jul 2024', title: 'Automotive Embedded Systems Diploma', org: 'NTI, New Capital', body: 'Embedded C, RTOS, STM32 & AVR, CAN/LIN/UART/SPI/I²C, bootloader/FOTA. Graduation project: a custom STM32F407 + ESP32-S3 industrial IoT controller platform.' },
  { period: 'Sep 2017 — Jul 2022', title: 'B.Sc. Electronics and Control Engineering', org: 'Menoufia University — Grade: Very Good', body: '' },
];
---

<Layout>
  <main>
    <section class="mx-auto max-w-7xl px-6 py-24 lg:px-8 lg:py-32">
      <div class="grid items-center gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:gap-14">
        <div class="max-w-3xl">
          <p class="text-base font-semibold uppercase tracking-[0.35em] text-sky-300">Hardware Engineer · Embedded Systems</p>
          <h1 class="mt-5 text-5xl font-semibold leading-[1.05] text-white sm:text-6xl lg:text-7xl">Designing dependable electronics from concept to production.</h1>
          <p class="mt-6 text-2xl leading-9 text-slate-200 sm:text-[1.65rem]">
            2+ years turning field problems into shipped hardware — 4-layer PCB design, RTOS firmware, EMI mitigation, and BMS for automotive and industrial IoT systems, with full lifecycle ownership from concept through manufacturing and deployment.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#projects" class="rounded-full bg-sky-500 px-8 py-4 text-xl font-semibold text-slate-950 transition hover:-translate-y-0.5 hover:bg-sky-400">View Projects</a>
            <a href="#contact" class="rounded-full border border-white/15 px-8 py-4 text-xl font-semibold text-slate-200 transition hover:-translate-y-0.5 hover:bg-white/10">Work with me</a>
          </div>
          <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-base text-slate-300">
            <span>Giza, Egypt</span>
            <a href="mailto:hossam.emad.5566@gmail.com" class="transition hover:text-sky-300">hossam.emad.5566@gmail.com</a>
            <span>Open to roles &amp; freelance projects</span>
          </div>
        </div>
        <div class="overflow-hidden rounded-[2rem] border border-white/10 bg-slate-900/70 shadow-[0_20px_80px_rgba(2,6,23,0.55)]">
          <img src="/images/hero/circuit-hero.svg" alt="" class="h-72 w-full object-cover" />
          <div class="p-8">
            <h2 class="text-3xl font-semibold text-white">Engineering focus</h2>
            <div class="mt-5 grid gap-3 text-lg text-slate-200 sm:grid-cols-2">
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4">4-layer PCB & signal integrity</div>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4">RTOS firmware (FreeRTOS)</div>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4">BMS & power electronics</div>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4">Automotive & industrial IoT</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="border-t border-white/10">
      <div class="mx-auto grid max-w-7xl gap-8 px-6 py-20 lg:grid-cols-[0.95fr_1.05fr] lg:px-8">
        <div>
          <p class="text-sm uppercase tracking-[0.3em] text-sky-300">About</p>
          <h2 class="section-heading">Professional engineering profile</h2>
        </div>
        <div class="rounded-[1.75rem] border border-white/10 bg-slate-900/60 p-8">
          <p class="section-copy">
            Hardware Engineer with 2+ years of hands-on experience in hardware design, PCB layout, firmware development, and production support. I independently identify field issues, propose solutions, and deliver improved hardware and firmware revisions end-to-end — with experience across automotive and industrial IoT systems, 4-layer high-speed PCB design, EMI mitigation, controlled impedance routing, BMS, and RTOS-based firmware, owning the full product lifecycle from concept through manufacturing and deployment.
          </p>
        </div>
      </div>
    </section>

    <section id="skills" class="border-t border-white/10">
      <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
        <p class="text-sm uppercase tracking-[0.3em] text-sky-300">Skills</p>
        <h2 class="section-heading">Core capabilities</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {skillGroups.map((group) => (
            <div class="rounded-[1.5rem] border border-white/10 bg-slate-900/70 p-6">
              <h3 class="text-xl font-semibold text-sky-300">{group.label}</h3>
              <div class="mt-4 flex flex-wrap gap-2">
                {group.skills.map((skill) => (
                  <span class="rounded-full border border-white/10 bg-white/5 px-3.5 py-2 text-base font-medium text-slate-100">{skill}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="projects" class="border-t border-white/10">
      <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
        <p class="text-sm uppercase tracking-[0.3em] text-sky-300">Projects</p>
        <h2 class="section-heading">Featured engineering case studies</h2>
        <div class="mt-8 grid gap-6 lg:grid-cols-3">
          {featuredProjects.map((project) => (
            <article class="overflow-hidden rounded-[1.5rem] border border-white/10 bg-slate-900/70 shadow-[0_14px_50px_rgba(2,6,23,0.38)] transition hover:-translate-y-1 hover:border-sky-400/30">
              <div class={`h-48 bg-gradient-to-br ${project.accent} p-4`}>
                <img src={project.image} alt={project.image.endsWith('.svg') ? `${project.title} — block diagram` : project.title} class={`h-full w-full rounded-[1rem] ${project.image.endsWith('.svg') ? 'bg-[#0B1424] object-contain' : 'object-cover'}`} loading="lazy" />
              </div>
              <div class="p-6">
                <h3 class="text-2xl font-semibold text-white">{project.title}</h3>
                <p class="mt-3 text-lg leading-8 text-slate-200">{project.summary}</p>
                <div class="mt-6 flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="rounded-full border border-sky-400/20 bg-sky-500/10 px-3 py-1.5 text-sm font-medium text-sky-200">{tag}</span>
                  ))}
                </div>
                <a href={project.href} class="mt-6 inline-flex text-base font-semibold text-sky-300 transition hover:text-sky-200">Read case study →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="experience" class="border-t border-white/10">
      <div class="mx-auto grid max-w-7xl gap-8 px-6 py-20 lg:grid-cols-2 lg:px-8">
        <div>
          <p class="text-sm uppercase tracking-[0.3em] text-sky-300">Experience</p>
          <h2 class="section-heading">Career</h2>
          <div class="mt-8 space-y-5">
            {experience.map((item) => (
            <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
              <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-300">{item.period}</p>
              <p class="mt-2 text-xl font-semibold text-white">{item.title}</p>
              <p class="mt-1 text-base font-medium text-slate-400">{item.org}</p>
              {item.body && <p class="mt-3 text-lg leading-8 text-slate-200">{item.body}</p>}
            </div>
            ))}
          </div>
        </div>
        <div>
          <p class="text-sm uppercase tracking-[0.3em] text-sky-300">Education</p>
          <h2 class="section-heading">Education &amp; certifications</h2>
          <div class="mt-8 space-y-5">
            {education.map((item) => (
            <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
              <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-300">{item.period}</p>
              <p class="mt-2 text-xl font-semibold text-white">{item.title}</p>
              <p class="mt-1 text-base font-medium text-slate-400">{item.org}</p>
              {item.body && <p class="mt-3 text-lg leading-8 text-slate-200">{item.body}</p>}
            </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="border-t border-white/10">
      <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
        <div class="rounded-[1.75rem] border border-sky-400/20 bg-gradient-to-br from-sky-500/10 to-slate-900/70 p-8 lg:p-12">
          <p class="text-sm uppercase tracking-[0.3em] text-sky-300">Contact</p>
          <h2 class="section-heading">Have a board to design or review?</h2>
          <p class="section-copy mt-4 max-w-3xl">I'm open to hardware and embedded roles (remote or relocation) and to freelance PCB design, design review, and firmware projects. Send a short description of what you're building.</p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="mailto:hossam.emad.5566@gmail.com?subject=Hardware%20project" class="rounded-full bg-sky-500 px-8 py-4 text-xl font-semibold text-slate-950 transition hover:-translate-y-0.5 hover:bg-sky-400">Email me</a>
            <a href="https://wa.me/201015891738?text=Hi%20Hossam%2C%20I%20found%20your%20portfolio%20and%20would%20like%20to%20discuss%20a%20project." target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-[#25D366] px-8 py-4 text-xl font-semibold text-slate-950 transition hover:-translate-y-0.5 hover:bg-[#20bd5a]"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 4.54 0 8.24 3.7 8.24 8.24 0 4.55-3.7 8.24-8.24 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29z"/></svg>WhatsApp</a>
            <a href="https://linkedin.com/in/hossamemad5566" class="rounded-full border border-white/15 px-8 py-4 text-xl font-semibold text-slate-200 transition hover:-translate-y-0.5 hover:bg-white/10">Message on LinkedIn</a>
            <a href="/resume" class="rounded-full border border-white/15 px-8 py-4 text-xl font-semibold text-slate-200 transition hover:-translate-y-0.5 hover:bg-white/10">Resume</a>
          </div>
          <p class="mt-6 text-base text-slate-400">hossam.emad.5566@gmail.com · WhatsApp +20 10 15891738 · Giza, Egypt</p>
        </div>
      </div>
    </section>
  </main>
</Layout>

---
import { getLang, lp, altPath, t } from '../i18n';

const lang = getLang(Astro.url);
const T = t(lang);
const links = [
  { label: T.nav.about, href: lp(lang, '/#about') },
  { label: T.nav.projects, href: lp(lang, '/#projects') },
  { label: T.nav.experience, href: lp(lang, '/#experience') },
  { label: T.nav.notes, href: lp(lang, '/notes') },
  { label: T.nav.resume, href: lp(lang, '/resume') },
  { label: T.nav.contact, href: lp(lang, '/#contact') },
];
const switchHref = altPath(Astro.url);
const switchLang = lang === 'ar' ? 'en' : 'ar';
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/70 backdrop-blur-xl">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-4 lg:px-8" aria-label={lang === 'ar' ? 'القائمة الرئيسية' : 'Main'}>
    <a href={lp(lang, '/')} class="font-display text-lg font-bold uppercase tracking-[0.25em] text-sky-300">{T.name}</a>
    <div class="flex items-center gap-3 md:gap-7">
      <div class="hidden items-center gap-7 md:flex">
        {links.map((link) => (
          <a href={link.href} class="text-[0.95rem] font-medium text-slate-300 transition hover:text-white">{link.label}</a>
        ))}
      </div>
      <a
        href={switchHref}
        hreflang={switchLang}
        lang={switchLang}
        aria-label={T.switchAria}
        class="rounded-full border border-sky-400/40 px-3.5 py-1.5 text-sm font-semibold text-sky-300 transition hover:bg-sky-400/10"
      >{T.switchLabel}</a>
      <details class="relative md:hidden">
        <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-xl border border-white/15 text-slate-200 [&::-webkit-details-marker]:hidden" aria-label={T.openMenu}>
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <div class="absolute end-0 mt-3 w-56 rounded-2xl border border-white/10 bg-slate-950/95 p-2 shadow-2xl">
          {links.map((link) => (
            <a href={link.href} class="block rounded-xl px-4 py-3 text-base font-medium text-slate-200 hover:bg-white/10 hover:text-white">{link.label}</a>
          ))}
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  // Close the mobile menu after a link is tapped.
  document.querySelectorAll('header details a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
  );
</script>

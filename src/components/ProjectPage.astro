---
import Layout from '../layouts/Layout.astro';
import type { Project } from '../data/projects';
import { localizeProject } from '../data/projects.ar';
import { getLang, lp, t } from '../i18n';

interface Props { project: Project; prev: Project; next: Project }
const lang = getLang(Astro.url);
const T = t(lang);
const project = localizeProject(Astro.props.project, lang);
const prev = localizeProject(Astro.props.prev, lang);
const next = localizeProject(Astro.props.next, lang);
const isDiagram = project.images[0].endsWith('.svg');
---

<Layout title={`${project.title} | ${T.name}`} description={project.summary}>
  <main class="mx-auto max-w-5xl px-6 py-16 lg:px-8">
    <a href={lp(lang, '/#projects')} class="text-sm font-semibold text-sky-300 hover:text-sky-200">{T.allProjects}</a>

    <header class="reveal mt-6">
      <p class="eyebrow">{project.category}</p>
      <h1 class="mt-3 text-3xl font-bold text-white sm:text-4xl lg:text-5xl">{project.title}</h1>
      <p class="mt-5 max-w-3xl text-lg text-slate-300">{project.summary}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        {project.tags.map((tag) => (
          <span dir="auto" class="rounded-full border border-sky-400/25 bg-sky-400/10 px-3 py-1 text-sm text-sky-200">{tag}</span>
        ))}
      </div>
    </header>

    <figure class="reveal mt-10 overflow-hidden rounded-2xl border border-white/10 bg-[#0B1424]">
      <img
        src={project.images[0]}
        alt={isDiagram ? `${project.title} — ${T.diagramAlt}` : project.title}
        class={isDiagram ? 'w-full' : 'max-h-[28rem] w-full object-cover'}
      />
      {isDiagram && <figcaption class="border-t border-white/10 px-5 py-3 text-sm text-slate-400">{T.diagramCaption}</figcaption>}
    </figure>

    <div class="mt-12 grid gap-12 lg:grid-cols-[1.25fr_0.75fr]">
      <div class="space-y-10">
        <section class="reveal">
          <h2 class="text-2xl font-semibold text-white">{T.myRole}</h2>
          <p class="mt-3 text-[1.05rem] text-slate-200">{project.role}</p>
        </section>
        <section class="reveal">
          <h2 class="text-2xl font-semibold text-white">{T.overview}</h2>
          <p class="mt-3 text-[1.05rem]">{project.overview}</p>
        </section>
        <section class="reveal">
          <h2 class="text-2xl font-semibold text-white">{T.challenge}</h2>
          <p class="mt-3 text-[1.05rem]">{project.challenge}</p>
        </section>
        <section class="reveal">
          <h2 class="text-2xl font-semibold text-white">{T.outcome}</h2>
          <p class="mt-3 text-[1.05rem]">{project.outcome}</p>
        </section>
        <section class="reveal">
          <h2 class="text-2xl font-semibold text-white">{T.lessons}</h2>
          <ul class="mt-3 space-y-2">
            {project.lessons.map((l) => (
              <li class="flex gap-3 text-[1.05rem] text-slate-300"><span aria-hidden="true" class="text-sky-300">{lang === 'ar' ? '←' : '→'}</span><span>{l}</span></li>
            ))}
          </ul>
        </section>
      </div>

      <aside class="reveal h-fit rounded-2xl border border-white/10 bg-ink-800/70 p-6 lg:sticky lg:top-24">
        <h2 class="text-lg font-semibold text-white">{T.keySpecs}</h2>
        <dl class="mt-4 divide-y divide-white/10">
          {project.specs.map((s) => (
            <div class="py-3">
              <dt class="text-xs font-semibold uppercase tracking-[0.15em] text-slate-500">{s.label}</dt>
              <dd class="mt-1 text-[0.95rem] text-slate-200">{s.value}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>

    {project.images.length > 1 && (
      <section class="reveal mt-14">
        <h2 class="text-2xl font-semibold text-white">{T.gallery}</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {project.images.slice(1).map((image) => (
            <a href={image} target="_blank" rel="noopener" class="group overflow-hidden rounded-xl border border-white/10 bg-ink-900">
              <img src={image} alt={`${project.title}`} loading="lazy" class="h-52 w-full object-cover transition duration-300 group-hover:scale-105" />
            </a>
          ))}
        </div>
      </section>
    )}

    <nav aria-label={T.moreProjects} class="mt-16 grid gap-4 border-t border-white/10 pt-8 sm:grid-cols-2">
      <a href={prev.href} class="group rounded-xl border border-white/10 p-5 hover:border-sky-400/40">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">{T.prev}</p>
        <p class="mt-1 font-semibold text-slate-200 group-hover:text-sky-300">{prev.title}</p>
      </a>
      <a href={next.href} class="group rounded-xl border border-white/10 p-5 text-end hover:border-sky-400/40">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-500">{T.next}</p>
        <p class="mt-1 font-semibold text-slate-200 group-hover:text-sky-300">{next.title}</p>
      </a>
    </nav>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href={lp(lang, '/#contact')} class="rounded-full bg-sky-400 px-6 py-3 text-base font-semibold text-ink-900 transition hover:-translate-y-0.5 hover:bg-sky-300">{T.discuss}</a>
      <a href={lp(lang, '/resume')} class="rounded-full border border-white/15 px-6 py-3 text-base font-semibold text-slate-200 transition hover:-translate-y-0.5 hover:bg-white/10">{T.viewResume}</a>
    </div>
  </main>
</Layout>

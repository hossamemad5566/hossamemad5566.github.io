---
import { getLang, t, whatsappUrl, gmailUrl } from '../i18n';
import { contact } from '../data/site';

const lang = getLang(Astro.url);
const T = t(lang);
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-slate-950/80">
  <div class="mx-auto flex max-w-7xl flex-col gap-3 px-6 py-8 text-sm text-slate-400 md:flex-row md:items-center md:justify-between lg:px-8">
    <p class="text-sm">© {currentYear} {T.fullName} · {T.role} · <a href="#top" class="text-sky-300 hover:text-sky-200">{T.backTop}</a></p>
    <div class="flex gap-4">
      <a href={contact.github} class="transition hover:text-white">GitHub</a>
      <a href={contact.linkedin} class="transition hover:text-white">LinkedIn</a>
      <a href={`mailto:${contact.email}`} class="transition hover:text-white">{T.email}</a>
      <a href={whatsappUrl(lang)} target="_blank" rel="noopener" class="transition hover:text-white">{T.whatsapp}</a>
    </div>
  </div>
</footer>

<a href={gmailUrl(lang)} target="_blank" rel="noopener" aria-label={T.gmailAria} class="fixed bottom-24 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-white text-[#EA4335] shadow-[0_10px_30px_rgba(0,0,0,0.45)] transition hover:-translate-y-0.5 hover:bg-slate-100">
  <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
</a>

<a href={whatsappUrl(lang)} target="_blank" rel="noopener" aria-label={T.waAria} class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-slate-950 shadow-[0_10px_30px_rgba(0,0,0,0.45)] transition hover:-translate-y-0.5 hover:bg-[#20bd5a]">
  <svg aria-hidden="true" width="30" height="30" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 4.54 0 8.24 3.7 8.24 8.24 0 4.55-3.7 8.24-8.24 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29z"/></svg>
</a>
